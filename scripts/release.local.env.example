# Copy to scripts/release.local.env (gitignored) and fill in.
# Every value is optional unless the matching step runs: --no-push does not
# need the GitCode settings, --no-chengdu does not need the host settings.

# GitCode mirror that receives the tag and the release assets (owner/repo).
GITCODE_REPO=

# git remote name pointing at that mirror.
GITCODE_REMOTE=gitcode

# SSH host (an ~/.ssh/config alias) that serves update.json and mirrors APKs.
CHENGDU_HOST=
CHENGDU_WEBROOT=

# Public HTTPS base URL of that host, without a trailing slash.
PUBLIC_BASE=

# SHA-256 of the release signing certificate. Get it with:
#   apksigner verify --print-certs app-release.apk
# Releases are refused when the built APK does not match this fingerprint.
CERT_SHA256=

# Optional. Defaults to the repository of the `origin` remote.
GITHUB_REPO=
