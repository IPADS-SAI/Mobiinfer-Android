# pr-watch 配置。被 watch.sh / review-one.sh / merge-ready.sh source。
# 修改后重启守护进程生效：scripts/pr-watch/stop.sh && scripts/pr-watch/start.sh

# 轮询间隔（秒）
POLL_SECONDS=${POLL_SECONDS:-120}

# 评审模型（codex -m）。默认 gpt-6.1-sol（vpsairobot 路由，经 magpie catalog）。
REVIEW_MODEL=${REVIEW_MODEL:-"vpsairobot/gpt-6.1-sol"}

# 单次评审墙钟超时（秒）
REVIEW_TIMEOUT=${REVIEW_TIMEOUT:-1800}

# 每小时最多跑几次评审，防止失控烧额度
MAX_REVIEWS_PER_HOUR=${MAX_REVIEWS_PER_HOUR:-4}

# 合并策略：auto = 评审通过即自动合并；label = 需要 merge-ok 标签；report = 只审不合
MERGE_POLICY=${MERGE_POLICY:-"auto"}
MERGE_METHOD=${MERGE_METHOD:-"squash"}

# 是否审外部 fork 的 PR。开启后只评审、不合并（merge-ready 永远拒绝 cross-repo）。
# 注意：fork 的 diff 是不可信输入，codex 虽有沙箱但仍有网络。
ALLOW_FORK_PR=${ALLOW_FORK_PR:-true}
# 是否允许自动合并外部 fork 的 PR（人类 2026-11-06 要求开启）。
# 仍然要求：结论 approve、T0 全过、head 未变（--match-head-commit）。
ALLOW_FORK_MERGE=${ALLOW_FORK_MERGE:-true}

# T1：是否跑 cmake 构建 + ctest（0 关闭；也可给 PR 打 run-build 标签单次开启）
# 构建在 bwrap 沙箱里跑：无网络、/home 被 tmpfs 遮住、只把 worktree 绑成可写。
# 只有在明确接受"在宿主直接执行未审代码"风险时才把 ALLOW_UNSANDBOXED_BUILD 设为 1。
RUN_BUILD_CHECK=${RUN_BUILD_CHECK:-0}
ALLOW_UNSANDBOXED_BUILD=${ALLOW_UNSANDBOXED_BUILD:-0}
# 没有 bwrap 时是否允许在无隔离环境跑评审（默认否：codex wrapper 会强制 bypass）
ALLOW_UNSANDBOXED_REVIEW=${ALLOW_UNSANDBOXED_REVIEW:-0}
BUILD_TIMEOUT=${BUILD_TIMEOUT:-2400}

# 人工刹车标签：带这些标签的 PR 不评审、不合并
HOLD_LABELS=${HOLD_LABELS:-"hold,do-not-merge"}

# 允许合并的目标分支
MERGE_BASE_BRANCH=${MERGE_BASE_BRANCH:-"main"}


# ---- bench 门禁 ----
# auto: PR 改到运行时路径（src/ ggml/ tools/ common/ examples/）才要求 bench 证据
# required: 一律要求；off: 关闭
BENCH_GATE=${BENCH_GATE:-auto}
BENCH_MIN_GAIN=${BENCH_MIN_GAIN:-0.015}
BENCH_NOISE_MULT=${BENCH_NOISE_MULT:-1.0}
BENCH_MIN_ROUNDS=${BENCH_MIN_ROUNDS:-4}
BENCH_PREFILL_MAX_REGRESSION=${BENCH_PREFILL_MAX_REGRESSION:-0.02}
BENCH_RSS_MAX_REGRESSION=${BENCH_RSS_MAX_REGRESSION:-0.02}
BENCH_MAX_AGE_HOURS=${BENCH_MAX_AGE_HOURS:-72}
# 合并时是否强制要求证据目录（manifest.json + 每轮原始日志）；0 只验统计数字
BENCH_REQUIRE_EVIDENCE=${BENCH_REQUIRE_EVIDENCE:-1}
# Stage 1 复现 agent（便宜模型）；最终判决仍用 REVIEW_MODEL
BENCH_AGENT_MODEL=${BENCH_AGENT_MODEL:-group/wb-deepseek}
BENCH_AGENT_TIMEOUT=${BENCH_AGENT_TIMEOUT:-5400}
# 复现 agent 内部每次取设备锁最多等多久（秒）；超时按失败处理，不无限阻塞
BENCH_LOCK_WAIT=${BENCH_LOCK_WAIT:-600}
# 基线缓存：main 的 v81 构建只做一次，按 main sha 复用；没缓存时自动建
BENCH_BASELINE_BUILD=${BENCH_BASELINE_BUILD:-1}
# 合并时是否要求 bench 的基线就是当前 main（main 一动就得重跑）；默认只提示
BENCH_REQUIRE_CURRENT_MAIN=${BENCH_REQUIRE_CURRENT_MAIN:-0}
# 基线缓存保留几个 main sha（每个约 170MB）
BENCH_BASELINE_KEEP=${BENCH_BASELINE_KEEP:-2}
# 是否让 watch 自动为缺证据的性能 PR 启动复现（默认关：会占设备很久）
BENCH_AUTO_REPRO=${BENCH_AUTO_REPRO:-0}

# ---- Stage 3：贵模型只看证据 + 高风险 diff ----
# 1 = 生成 packet（高风险全文/diff + 低风险摘要 + bench），0 = 旧的全量模式
REVIEW_PACKET=${REVIEW_PACKET:-1}
# 低风险摘要用便宜模型（失败自动退回文件清单）
PACKET_SUMMARY=${PACKET_SUMMARY:-1}
PACKET_SUMMARY_MODEL=${PACKET_SUMMARY_MODEL:-group/wb-deepseek}
# 高风险 diff 上限；超过会截断，并在 packet.md / 评论里显式标注截断量
PACKET_MAX_DIFF_BYTES=${PACKET_MAX_DIFF_BYTES:-400000}
# 高风险文件全文总预算；文件按"改动行数"从大到小排，超预算的在 packet.md 里标 omitted
PACKET_MAX_FILES_BYTES=${PACKET_MAX_FILES_BYTES:-300000}
PACKET_LOW_DIFF_BYTES=${PACKET_LOW_DIFF_BYTES:-80000}
# 每轮低风险摘要那次便宜模型调用的上限（watch.sh 的外层总预算要按它累加）
PACKET_SUMMARY_TIMEOUT=${PACKET_SUMMARY_TIMEOUT:-900}
# 材料缺口自动补一轮：verdict 的 needs_full_diff 里点名的、本 PR 改过的文件，
# 自动作为 PACKET_EXTRA 重开一轮评审（0 = 关，退回人工升级）
REVIEW_AUTO_EXPAND=${REVIEW_AUTO_EXPAND:-1}
PACKET_MAX_ATTEMPTS=${PACKET_MAX_ATTEMPTS:-2}
# 补材料轮的全文总预算（比 PACKET_MAX_FILES_BYTES 宽），否则已给全文的文件
# 会把新点名的文件挤掉，补一轮等于白补
PACKET_EXTRA_MAX_FILES_BYTES=${PACKET_EXTRA_MAX_FILES_BYTES:-600000}

# 可选：评审结果推送到 webhook（telegram/ntfy 等），留空则只写日志
NOTIFY_WEBHOOK=${NOTIFY_WEBHOOK:-""}
